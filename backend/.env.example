# Salin berkas ini menjadi .env lalu isi nilainya. Berkas .env tidak boleh di-commit.
# Rahasia dibuat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"

# development, testing, atau production. Bila kosong, aplikasi berjalan sebagai production.
APP_ENV=development

# Rahasia minimal 32 byte dan harus berbeda satu sama lain. Aplikasi menolak start bila
# nilainya masih "ganti-dengan-...".
# SECRET_KEY dipakai untuk tanda tangan tautan Eir (itsdangerous) mulai Tahap 4.
SECRET_KEY=ganti-dengan-rahasia-acak-minimal-32-byte
# JWT_SECRET_KEY menandatangani access token, refresh token, dan klaim CSRF.
JWT_SECRET_KEY=ganti-dengan-rahasia-acak-lain-minimal-32-byte

# Aplikasi berjalan sebagai role smarttriage_app (tanpa hak UPDATE/DELETE pada log_audit),
# sedangkan migrasi dijalankan oleh role pemilik skema. Awalan postgres:// atau postgresql://
# otomatis diubah ke postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://smarttriage_app:password-app@127.0.0.1:5432/smarttriage
DATABASE_URL_MIGRASI=postgresql+psycopg://smarttriage_owner:password-owner@127.0.0.1:5432/smarttriage

# Password role basis data untuk docker compose (harus sama dengan dua URL di atas).
DB_OWNER_PASSWORD=password-owner
DB_APP_PASSWORD=password-app

# Jumlah proxy tepercaya di depan aplikasi (misalnya load balancer Railway).
# Biarkan 0 di lokal; nilai yang salah membuat alamat IP klien bisa dipalsukan.
JUMLAH_PROXY=0

# Password akun demo untuk perintah `flask seed-demo` (minimal 8 karakter).
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_PERAWAT=
SEED_PASSWORD_DOKTER=

# Basis data khusus pytest. Nama database WAJIB berakhiran _test karena dihapus dan dibuat
# ulang setiap kali tes dijalankan. Role pemilik membutuhkan hak CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://smarttriage_app:password-app@127.0.0.1:5432/smarttriage_test
TEST_DATABASE_URL_MIGRASI=postgresql+psycopg://smarttriage_owner:password-owner@127.0.0.1:5432/smarttriage_test

# Lokasi bundle Random Forest. Boleh dikosongkan untuk memakai bawaan app/ai/artefak/model_rf.joblib.
# Path relatif dihitung dari folder backend. Bila berkas tidak ada, rekomendasi memakai aturan cadangan
# dan GET /api/v1/health berstatus degraded.
# MODEL_RF_PATH=app/ai/artefak/model_rf.joblib

# Lokasi model YOLO pembaca layar alat (ONNX). Bila berkas tidak ada, pemindaian tetap tersimpan
# tetapi semua kolom dikosongkan untuk diisi manual, dan GET /api/v1/health berstatus degraded.
# MODEL_YOLO_PATH=app/ai/artefak/yolo_digit.onnx
# Isi "tiruan" untuk mencoba alur pemindaian dengan angka contoh tanpa model. Hanya untuk development.
# PEMBACA_LAYAR=onnx

# Kunci Groq API untuk Eir (LLM openai/gpt-oss-20b dan Whisper). Bila kosong, Eir membalas 503,
# deteksi tanda bahaya tetap berjalan, dan GET /api/v1/health berstatus degraded.
# GROQ_API_KEY=
# Isi "tiruan" untuk mencoba alur Eir dengan pertanyaan contoh tanpa kunci Groq. Hanya untuk development.
# LLM_EIR=groq
# Folder 18 berkas panduan anamnesis. Boleh dikosongkan untuk memakai bawaan app/ai/artefak/panduan.
# PANDUAN_EIR_PATH=app/ai/artefak/panduan

# Dipakai mulai tahap berikutnya:
# SENTRY_DSN=
