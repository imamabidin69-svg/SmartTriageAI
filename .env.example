# Salin berkas ini jadi .env.local untuk pengembangan lokal, dan isi
# variabel yang SAMA di dashboard Vercel (Settings > Environment Variables)
# untuk produksi. JANGAN PERNAH commit .env.local ke git (sudah masuk
# .gitignore) - berkas .env.example ini yang boleh di-commit karena TIDAK
# berisi nilai rahasia sungguhan, cuma daftar nama variabel yang dibutuhkan.

# Kunci rahasia untuk menandatangani (HMAC) cookie sesi - lib/session-cookie.ts.
# WAJIB diisi nilai acak yang panjang & unik di produksi (mis. `openssl rand -hex 32`).
# TIDAK diberi prefiks NEXT_PUBLIC_ karena harus tetap rahasia di server.
SESSION_SECRET=

# Alamat layanan machine learning SmartTriage AI (folder ml-service/, app.py)
# - dipakai lib/ml-client.ts. Kalau kosong atau layanan tidak bisa dihubungi,
# sistem otomatis jatuh ke classify.ts berbasis aturan (lihat lib/ml-client.ts),
# jadi triase tetap jalan meski layanan ML sedang mati.
# Contoh lokal: http://127.0.0.1:8000
# Contoh produksi: host terpisah dari Vercel, lihat ml-service/README.md
ML_SERVICE_URL=
